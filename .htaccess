RewriteEngine On

# Canonical host: force non-www apex to www (matches rel=canonical, sitemap and schema everywhere on the site)
RewriteCond %{HTTP_HOST} ^growthyug\.in$ [NC]
RewriteRule ^(.*)$ https://www.growthyug.in/$1 [R=301,L]

# Legacy Shopify URL redirects (301)
Redirect 301 /pages/privacy-policy /privacy-policy/
Redirect 301 /pages/contact /contact/
Redirect 301 /pages/terms-conditions /terms-conditions/
Redirect 301 /blogs/amazon/amazon-growth-isn-t-about-traffic-it-s-about-momentum /services/marketplace-management/amazon/
Redirect 301 /blogs/amazon /services/marketplace-management/amazon/
Redirect 301 /b /
